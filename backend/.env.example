APP_ENV=development
LOG_LEVEL=INFO

# 공공데이터포털 일반 인증키를 입력하세요. 실제 키는 이 파일에 넣지 않습니다.
DATA_GO_KR_SERVICE_KEY=replace_with_data_go_kr_service_key
NCP_MAPS_CLIENT_ID=replace_with_ncp_maps_client_id
NCP_MAPS_CLIENT_SECRET=replace_with_ncp_maps_client_secret
# NAVER API HUB 지역 검색용 인증정보. 모바일 앱에 넣지 않습니다.
NCP_LOCAL_SEARCH_CLIENT_ID=replace_with_ncp_local_search_client_id
NCP_LOCAL_SEARCH_CLIENT_SECRET=replace_with_ncp_local_search_client_secret
MOBILE_APP_NAME=TravelCongestion

REQUEST_TIMEOUT_SECONDS=60
REQUEST_CONNECT_TIMEOUT_SECONDS=10
MAX_EVENTS_PER_ANALYSIS=100
MAX_CONCURRENT_UPSTREAM_REQUESTS=10
MAX_REQUEST_BODY_BYTES=65536
